<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks outgoing Apple Events by default. This single entitlement lets the
	     app ask Finder to move reviewed software bundles to the Trash (see NSAppleEventsUsageDescription).
	     No other automation, network, or file-access entitlement is granted. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
